# Copy to .env and fill in. Everything except the secret is optional.

# Public URL of the app (used by auth for cookies / OAuth callbacks)
APP_ORIGIN=http://localhost:3000
# Random string, at least 32 chars:  openssl rand -base64 32
APP_AUTH_SECRET=change-me-change-me-change-me-change-me
# SQLite file location
APP_DB_PATH=./data/app.db

# Allow new email/password signups (set false on a public demo instance)
APP_ALLOW_SIGNUP=true
# Show "Try the demo" (guest accounts, wiped after 24h)
APP_DEMO_ENABLED=true

# TMDB (Watch category autocomplete). Use the v4 "API Read Access Token".
# Without it, Watch works as a custom-only category.
TMDB_API_KEY=

# Places (Eat / Visit / Drink autocomplete) from OpenStreetMap. No key needed; on by default.
# Search uses Photon (komoot), details use Nominatim /lookup (max 1 req/s). Data is ODbL: the app shows
# "© OpenStreetMap contributors" wherever places appear. Set false to turn places off.
APP_PLACES_ENABLED=true
# Your own Photon / Nominatim (recommended for busy instances). Empty = the public servers.
# NOMINATIM_URL=off skips the details lookup (details then come from the search result only).
PHOTON_URL=
NOMINATIM_URL=
# Contact address sent to Nominatim (User-Agent and email param), as its usage policy asks.
APP_CONTACT_EMAIL=
# Map tiles on place pages ({z}/{x}/{y}). Empty = tile.openstreetmap.org; "off" hides the map.
APP_MAP_TILES_URL=

# Optional OAuth. A provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# SMTP for password resets and notification emails (digests, reminders).
# With Docker Compose, leaving SMTP_URL empty sends everything to the bundled Mailpit inbox
# (http://localhost:8025). Outside Docker, empty SMTP_URL means no email (use the admin CLI for resets).
# Percent-encode special characters in the username/password: @ becomes %40.
# Gmail (needs 2-step verification and an app password, https://myaccount.google.com/apppasswords):
#   SMTP_URL=smtps://you%40gmail.com:your-app-password@smtp.gmail.com:465
#   SMTP_FROM="Forgetless <you@gmail.com>"
# Local Mailpit outside Compose: SMTP_URL=smtp://localhost:1025
SMTP_URL=
# From address. Default: "Forgetless" <no-reply@<APP_ORIGIN host>>
SMTP_FROM=

# Web Push (VAPID). Leave empty: a key pair is generated on first use and stored in the database.
# Set all three to use your own keys (npx web-push generate-vapid-keys). Changing keys means every
# device has to turn push on again.
APP_VAPID_PUBLIC_KEY=
APP_VAPID_PRIVATE_KEY=
# Contact for push services: mailto:you@example.com or https://your-site. Default: derived from
# APP_ORIGIN / SMTP_FROM.
APP_VAPID_SUBJECT=
# How often the notification scheduler checks for due digests/reminders, in ms (default 300000 = 5 min).
# 0 turns scheduled notifications off.
# APP_NOTIFY_TICK_MS=300000
