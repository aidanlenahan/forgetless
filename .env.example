# Copy to .env and fill in. Everything except the secret is optional.

# Public URL of the app (used by auth for cookies / OAuth callbacks)
APP_ORIGIN=http://localhost:3000
# Random string, at least 32 chars:  openssl rand -base64 32
APP_AUTH_SECRET=change-me-change-me-change-me-change-me
# SQLite file location
APP_DB_PATH=./data/app.db

# Allow new email/password signups (set false on a public demo instance)
APP_ALLOW_SIGNUP=true
# Show "Try the demo" (guest accounts, wiped after 24h)
APP_DEMO_ENABLED=true

# TMDB (Watch category autocomplete). Use the v4 "API Read Access Token".
# Without it, Watch works as a custom-only category.
TMDB_API_KEY=

# Optional OAuth. A provider is enabled only when both values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional SMTP for password-reset emails. Without it, use: npm run admin -- reset-password <email> <newpass>
SMTP_URL=
SMTP_FROM=
